# ============================================================
# AeroCause Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- MySQL (production / docker) ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=aerocause
MYSQL_USER=aerocause
MYSQL_PASSWORD=changeme

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
# Dev profile uses H2 in-memory database (no MySQL needed).
# Set to "prod" to use MySQL.

# --- OpenAQ (optional, replay works without this) ---
# Register at https://openaq.org to get a free API key (v3).
OPENAQ_API_KEY=

# --- NASA FIRMS Fire Hotspots (optional, OFF by default) ---
# Register at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=
FIRE_HOTSPOT_ENABLED=false

# --- AI Service ---
# Set to "mock" for deterministic narration (no API key needed) or "openai"
# for an OpenAI-compatible chat-completions provider.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1/chat/completions

# Retrieval embeddings default to a local sentence-transformers model.
# Set EMBEDDING_PROVIDER=api and provide the compatible endpoint/key to use an API.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
RETRIEVAL_MIN_SIMILARITY=0.25

# --- Polling (disabled by default; replay is used for demo) ---
INGESTION_POLLING_ENABLED=false
INGESTION_POLLING_INTERVAL_SECONDS=300

# --- Service ports ---
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173
POLL_INTERVAL_MS=10000
OFFICIAL_REPORT_URL=https://cpcb.nic.in/
