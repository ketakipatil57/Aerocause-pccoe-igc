# ============================================================
# AeroCause Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- MySQL (production / docker) ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=aerocause
MYSQL_USER=aerocause
MYSQL_PASSWORD=changeme

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
# Dev profile uses H2 in-memory database (no MySQL needed).
# Set to "prod" to use MySQL.

# --- OpenAQ (optional, replay works without this) ---
# Register at https://openaq.org to get a free API key (v3).
OPENAQ_API_KEY=

# --- NASA FIRMS Fire Hotspots (optional, OFF by default) ---
# Register at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=
FIRE_HOTSPOT_ENABLED=false

# --- AI Service ---
# Set to "mock" to use deterministic mock LLM (no API key needed).
# Set to "live" to use a real LLM.
LLM_MODE=mock
# If LLM_MODE=live, set your Google AI / OpenAI key:
GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Polling (disabled by default; replay is used for demo) ---
INGESTION_POLLING_ENABLED=false
INGESTION_POLLING_INTERVAL_SECONDS=300

# --- Service ports ---
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173
